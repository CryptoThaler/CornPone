# Google Maps API Key (required for Android, optional for iOS)
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for iOS, Maps SDK for Android, Directions API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# EAS Project ID (from expo.dev)
EAS_PROJECT_ID=your_eas_project_id

# Apple Developer credentials (for TestFlight submission)
APPLE_ID=your_apple_id@email.com
ASC_APP_ID=your_app_store_connect_app_id
APPLE_TEAM_ID=your_apple_team_id
